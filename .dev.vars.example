# Copy to .dev.vars for local development. Never commit .dev.vars.
ENVIRONMENT=development
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:8787
ADMIN_ORIGIN=http://localhost:5173
MEDIA_PUBLIC_BASE_URL=http://localhost:8787/v1/media
# Local only: acts as this admin user instead of verifying a Cloudflare Access token.
# Ignored unless ENVIRONMENT=development.
DEV_ADMIN_EMAIL=you@example.com
